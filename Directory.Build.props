<Project>
  <PropertyGroup>
    <!-- ── 编译 ── -->
    <RaindropTargetFramework>net10.0</RaindropTargetFramework>
    <TargetFramework>$(RaindropTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- ── 调试信息 ── -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Label="Package Versions">
    <ApolloConfigurationVersion>2.11.0</ApolloConfigurationVersion>
    <CoverletCollectorVersion>10.1.0</CoverletCollectorVersion>
    <MapsterVersion>10.0.13</MapsterVersion>
    <MediatRSourceVersion>12.5.0</MediatRSourceVersion>
    <MicrosoftEntityFrameworkCoreVersion>10.0.13</MicrosoftEntityFrameworkCoreVersion>
    <MicrosoftExtensionsVersion>10.0.13</MicrosoftExtensionsVersion>
    <MicrosoftNetTestSdkVersion>18.11.0</MicrosoftNetTestSdkVersion>
    <NpgsqlVersion>10.0.3</NpgsqlVersion>
    <NpgsqlEntityFrameworkCorePostgreSqlVersion>10.0.3</NpgsqlEntityFrameworkCorePostgreSqlVersion>
    <OpenTelemetryVersion>1.19.1</OpenTelemetryVersion>
    <OpenTelemetryInstrumentationVersion>1.19.0</OpenTelemetryInstrumentationVersion>
    <RabbitMqClientVersion>7.2.2</RabbitMqClientVersion>
    <XunitVersion>2.9.3</XunitVersion>
    <XunitRunnerVisualStudioVersion>3.1.5</XunitRunnerVisualStudioVersion>
    <FluentValidationVersion>12.2.0</FluentValidationVersion>
  </PropertyGroup>
</Project>
